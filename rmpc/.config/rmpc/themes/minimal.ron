#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None, 
    text_color: Some("#B2CFFF"),
    header_background_color: Some("#05050C"),
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "#697C9B"),
    preview_metadata_group_style: (fg: "#697C9B", modifiers: "Bold"),
    tab_bar: (
        active_style: (fg: "#030308", bg: "#4C73A0", modifiers: "Bold"),
        inactive_style: (),
    ),
    /* FIX 1: Selection Style - Text is now bright blue (foreground) */
    highlighted_item_style: (fg: "#B2CFFF", bg: "#5A739B", modifiers: "Bold"),
    current_item_style: (fg: "#467DBD", bg: "#5176A1", modifiers: "Bold"),
    
    borders_style: (fg: "#4C73A0"),
    highlight_border_style: (fg: "#4C73A0"),
    symbols: (
        song: "󰎈",     
        dir: "󰉋",      
        playlist: "󰲒", 
        marker: "󰓎",   
        ellipsis: "...",        
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    /* FIX 2: Progress Bar - Foreground fill against dull color1 track */
    progress_bar: (
        symbols:["▆","▆","▆","▆","▆"],
        track_style: (fg: "#444F61"),
        elapsed_style: (fg: "#B2CFFF"),
        thumb_style: (fg: "#B2CFFF"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#6480AC"),
        ends_style: (fg: "#6480AC"),
        thumb_style: (fg: "#6480AC"),
    ),
cava: (
        bar_symbols: [' ', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bg_color: None, // Uses your transparent background
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
        // Using Matugen Gradient for the bars
        bar_color: Gradient({
            0: "#444F61",   // Red/Maroon
            30: "#4C73A0",  // Blue
            70: "#B2CFFF", // Magenta
        })
    ),
    song_table_format: [
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            width: "50%",
        ),
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            width: "45%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            width: "10%",
            alignment: Right,
        ),
    ],
    components: {},
    layout: Pane(TabContent),
      header: (
        rows: [
            (
                left: [
                    (kind: Text("  ")), // Padding from left edge
                    (
                        kind: Property(Status(StateV2(
                            playing_label: "󰐊", 
                            paused_label: "󰏤", 
                            stopped_label: "󰓛"
                        ))), 
                        style: (fg: "#5176A1", modifiers: "Bold")
                    ),
                ],
                center: [
                    (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Property(Widget(ScanStatus)), style: (fg: "#4C73A0")),
                    (kind: Property(Widget(Volume)), style: (fg: "#4C73A0")),
                    (kind: Text("  ")) // Padding from right edge
                ]
            ),
            (
                left: [
                    (kind: Text("  ")), // Padding from left edge
                    (kind: Property(Status(Elapsed))),
                    (kind: Text(" / ")),
                    (kind: Property(Status(Duration))),
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)"))
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#5176A1", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#5176A1", modifiers: "Bold"))
                    ),
                    (kind: Text(" - ")),
                    (kind: Property(Song(Album)),
                        default: (kind: Text("Unknown Album"))
                    )
                ],
                right: [
                    (
                        kind: Property(Status(RepeatV2(
                            on_label: "󰑖", 
                            off_label: "󰑖", 
                            on_style: (fg: "#4C73A0", modifiers: "Bold"), 
                            off_style: (fg: "#A3C0F0")
                        ))),
                    ),
                    (kind: Text(" / "), style: (fg: "#A3C0F0")),
                    (
                        kind: Property(Status(RandomV2(
                            on_label: "󰒝", 
                            off_label: "󰒝", 
                            on_style: (fg: "#4C73A0", modifiers: "Bold"), 
                            off_style: (fg: "#A3C0F0")
                        ))),
                    ),
                    (kind: Text(" / "), style: (fg: "#A3C0F0")),
                    (
                        kind: Property(Status(ConsumeV2(
                            on_label: "󰆐", 
                            off_label: "󰆐", 
                            on_style: (fg: "#4C73A0", modifiers: "Bold"), 
                            off_style: (fg: "#A3C0F0")
                        ))),
                    ),
                    (kind: Text(" / "), style: (fg: "#A3C0F0")),
                    (
                        kind: Property(Status(SingleV2(
                            on_label: "󰑘", 
                            off_label: "󰑘", 
                            on_style: (fg: "#4C73A0", modifiers: "Bold"), 
                            off_style: (fg: "#A3C0F0")
                        ))),
                    ),
                    (kind: Text("  ")), // Padding from right edge
                ]
            ),
        ],
      ),
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    lyrics: (
        timestamp: false
    )
)
