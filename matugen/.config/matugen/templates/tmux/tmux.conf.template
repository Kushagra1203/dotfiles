# --- Matugen Variable Mappings ---
# Accent  -> {{colors.primary.default.hex}}
# Surface -> {{colors.surface_container_highest.default.hex}}

# --- General Config ---
unbind C-b
set -g prefix C-a
bind C-a send-prefix

unbind r
bind r source-file ~/.config/tmux/tmux.conf

set -g mouse on
set -g status-interval 5
set -g status-style bg=default

unbind %
bind | split-window -h -c "#{pane_current_path}"
unbind '"'
bind - split-window -v -c "#{pane_current_path}"

bind -r j resize-pane -D 3 
bind -r k resize-pane -U 3
bind -r l resize-pane -R 3
bind -r h resize-pane -L 3

bind -r m resize-pane -Z

setw -g mode-keys vi
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel

bind C-g display-popup \
  -d "#{pane_current_path}" \
  -w 80% \
  -h 80% \
  -E "lazygit"
  
bind C-n display-popup -E 'bash -i -c "read -p \"Session name: \" name; tmux new-session -d -s \$name && tmux switch-client -t \$name"'

bind C-j display-popup -E "tmux list-sessions | sed -E 's/:.*$//' | grep -v \"^$(tmux display-message -p '#S')\$\" | fzf --reverse | xargs tmux switch-client -t"

bind C-f if-shell -F '#{popup_active}' 'display-popup -C' 'display-popup -w 80% -h 80% -E rmpc'

bind C-y display-popup \
  -d "#{pane_current_path}" \
  -w 90% \
  -h 90% \
  -E "yazi"

bind C-z display-popup \
  -w 80% \
  -h 80% \
  -E 'nvim ~/.zshrc'

bind C-t display-popup \
  -d "#{pane_current_path}" \
  -w 75% \
  -h 75% \
  -E "zsh"


# --- Plugins ---
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-yank'

# --- THE "DIAMOND SPACE" THEME ---

# 1. ADD SPACING: This ensures windows don't look like one long box
set -g window-status-separator "" 

# 2. SESSION: |session>
# Flat start, pointed end.
set -g status-left-length 30
set -g status-left "#[bg={{colors.primary.default.hex}},fg={{colors.on_primary.default.hex}},bold] #S #[fg={{colors.primary.default.hex}},bg=default,nobold]"

# 3. INACTIVE WINDOWS: <1>
# Pointed start () and pointed end () using the Fedora grey color.
set -g window-status-format "#[fg={{colors.surface_container_highest.default.hex}},bg=default]#[bg={{colors.surface_container_highest.default.hex}},fg={{colors.on_surface.default.hex}}] #I:#W #[fg={{colors.surface_container_highest.default.hex}},bg=default]"

# 4. ACTIVE WINDOW: <active>
# Pointed start () and pointed end () using the Primary Accent color.
set -g window-status-current-format "#[fg={{colors.primary.default.hex}},bg=default]#[bg={{colors.primary.default.hex}},fg={{colors.on_primary.default.hex}},bold] #I:#W #[fg={{colors.primary.default.hex}},bg=default]"

# --- RIGHT SIDE (Keeping your working layered design) ---
set -g status-right-length 50
set -g status-right "#[fg={{colors.surface_container_highest.default.hex}},bg=default]#[bg={{colors.surface_container_highest.default.hex}},fg={{colors.on_surface.default.hex}}] #H #[fg={{colors.primary_container.default.hex}},bg={{colors.surface_container_highest.default.hex}}]#[bg={{colors.primary_container.default.hex}},fg={{colors.on_primary_container.default.hex}}] %H:%M #[bg={{colors.primary_container.default.hex}},fg={{colors.primary.default.hex}}]#[bg={{colors.primary.default.hex}},fg={{colors.on_primary.default.hex}},bold] %d-%b-%y "

# --- Borders & Terminal ---
set -g pane-border-style fg={{colors.surface_container_highest.default.hex}}
set -g pane-active-border-style fg={{colors.primary.default.hex}}
set -g default-terminal "tmux-256color"
set-option -ga terminal-overrides ",xterm-256color:Tc"
set -g renumber-windows on
set -g base-index 1

run '~/.tmux/plugins/tpm/tpm'
