#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None, 
    text_color: Some("{{colors.on_surface.default.hex}}"),
    header_background_color: Some("{{colors.surface_container_low.default.hex}}"),
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "{{colors.tertiary.default.hex}}"),
    preview_metadata_group_style: (fg: "{{colors.tertiary.default.hex}}", modifiers: "Bold"),
    tab_bar: (
        active_style: (fg: "{{colors.on_primary.default.hex}}", bg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
        inactive_style: (),
    ),
    highlighted_item_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
    current_item_style: (fg: "{{colors.on_secondary_container.default.hex}}", bg: "{{colors.secondary_container.default.hex}}", modifiers: "Bold"),
    borders_style: (fg: "{{colors.primary.default.hex}}"),
    highlight_border_style: (fg: "{{colors.primary.default.hex}}"),
    symbols: (
        song: "󰎈",     
        dir: "󰉋",      
        playlist: "󰲒", 
        marker: "󰓎",   
        ellipsis: "...",       
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    progress_bar: (
        symbols:["▆","▆","▆","▆","▆"],
        track_style: (fg: "{{colors.surface_variant.default.hex}}"),
        elapsed_style: (fg: "{{colors.primary.default.hex}}"),
        thumb_style: (fg: "{{colors.primary.default.hex}}"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "{{colors.outline_variant.default.hex}}"),
        ends_style: (fg: "{{colors.outline_variant.default.hex}}"),
        thumb_style: (fg: "{{colors.outline_variant.default.hex}}"),
    ),
    cava: (
        bar_symbols: [' ', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bg_color: None, // Uses your transparent background
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
        // Using Matugen Gradient for the bars
        bar_color: Gradient({
            0: "{{colors.primary.default.hex}}",
            30: "{{colors.secondary.default.hex}}",           
            70: "{{colors.tertiary.default.hex}}",         
        })
    ),
    song_table_format: [
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            width: "50%",
        ),
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            width: "45%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            width: "10%",
            alignment: Right,
        ),
    ],
    components: {},
    layout: Pane(TabContent),
      header: (
        rows: [
            (
                left: [
                    (kind: Text("  ")), // Padding from left edge
                    (
                        kind: Property(Status(StateV2(
                            playing_label: "󰐊", 
                            paused_label: "󰏤", 
                            stopped_label: "󰓛"
                        ))), 
                        style: (fg: "{{colors.secondary.default.hex}}", modifiers: "Bold")
                    ),
                ],
                center: [
                    (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Property(Widget(ScanStatus)), style: (fg: "{{colors.primary.default.hex}}")),
                    (kind: Property(Widget(Volume)), style: (fg: "{{colors.primary.default.hex}}")),
                    (kind: Text("  ")) // Padding from right edge
                ]
            ),
            (
                left: [
                    (kind: Text("  ")), // Padding from left edge
                    (kind: Property(Status(Elapsed))),
                    (kind: Text(" / ")),
                    (kind: Property(Status(Duration))),
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)"))
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "{{colors.secondary.default.hex}}", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "{{colors.secondary.default.hex}}", modifiers: "Bold"))
                    ),
                    (kind: Text(" - ")),
                    (kind: Property(Song(Album)),
                        default: (kind: Text("Unknown Album"))
                    )
                ],
                right: [
                    (
                        kind: Property(Status(RepeatV2(
                            on_label: "󰑖", 
                            off_label: "󰑖", 
                            on_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"), 
                            off_style: (fg: "{{colors.on_surface_variant.default.hex}}")
                        ))),
                    ),
                    (kind: Text(" / "), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
                    (
                        kind: Property(Status(RandomV2(
                            on_label: "󰒝", 
                            off_label: "󰒝", 
                            on_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"), 
                            off_style: (fg: "{{colors.on_surface_variant.default.hex}}")
                        ))),
                    ),
                    (kind: Text(" / "), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
                    (
                        kind: Property(Status(ConsumeV2(
                            on_label: "󰆐", 
                            off_label: "󰆐", 
                            on_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"), 
                            off_style: (fg: "{{colors.on_surface_variant.default.hex}}")
                        ))),
                    ),
                    (kind: Text(" / "), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
                    (
                        kind: Property(Status(SingleV2(
                            on_label: "󰑘", 
                            off_label: "󰑘", 
                            on_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"), 
                            off_style: (fg: "{{colors.on_surface_variant.default.hex}}")
                        ))),
                    ),
                    (kind: Text("  ")), // Padding from right edge
                ]
            ),
        ],
      ),
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    lyrics: (
        timestamp: false
    )
)
