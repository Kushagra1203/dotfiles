.theme-dark,
.theme-dark.ctp-mocha {
  /* Core Backgrounds */
  --ctp-base: {{colors.surface.default.red}}, {{colors.surface.default.green}}, {{colors.surface.default.blue}};
  --ctp-mantle: {{colors.surface_container.default.red}}, {{colors.surface_container.default.green}}, {{colors.surface_container.default.blue}};
  --ctp-crust: {{colors.surface_container_lowest.default.red}}, {{colors.surface_container_lowest.default.green}}, {{colors.surface_container_lowest.default.blue}};

  /* Text & Labels */
  --ctp-text: {{colors.on_surface.default.red}}, {{colors.on_surface.default.green}}, {{colors.on_surface.default.blue}};
  --ctp-subtext1: {{colors.on_surface_variant.default.red}}, {{colors.on_surface_variant.default.green}}, {{colors.on_surface_variant.default.blue}};
  --ctp-subtext0: {{colors.on_surface_variant.default.red}}, {{colors.on_surface_variant.default.green}}, {{colors.on_surface_variant.default.blue}};  
  
  /* Overlays & Surfaces */
  --ctp-overlay2: {{colors.outline.default.red}}, {{colors.outline.default.green}}, {{colors.outline.default.blue}};
  --ctp-overlay1: {{colors.outline_variant.default.red}}, {{colors.outline_variant.default.green}}, {{colors.outline_variant.default.blue}};
  --ctp-overlay0: {{colors.outline_variant.default.red}}, {{colors.outline_variant.default.green}}, {{colors.outline_variant.default.blue}};
  --ctp-surface2: {{colors.surface_container_high.default.red}}, {{colors.surface_container_high.default.green}}, {{colors.surface_container_high.default.blue}};
  --ctp-surface1: {{colors.surface_container_low.default.red}}, {{colors.surface_container_low.default.green}}, {{colors.surface_container_low.default.blue}};
  --ctp-surface0: {{colors.surface_container_lowest.default.red}}, {{colors.surface_container_lowest.default.green}}, {{colors.surface_container_lowest.default.blue}};

  /* Accents (Mapped to Material You Palette) */
  --ctp-accent: {{colors.primary.default.red}}, {{colors.primary.default.green}}, {{colors.primary.default.blue}};
  --ctp-blue: {{colors.primary.default.red}}, {{colors.primary.default.green}}, {{colors.primary.default.blue}};
  --ctp-lavender: {{colors.primary_fixed.default.red}}, {{colors.primary_fixed.default.green}}, {{colors.primary_fixed.default.blue}};
  --ctp-sapphire: {{colors.secondary.default.red}}, {{colors.secondary.default.green}}, {{colors.secondary.default.blue}};
  --ctp-sky: {{colors.secondary_fixed.default.red}}, {{colors.secondary_fixed.default.green}}, {{colors.secondary_fixed.default.blue}};
  --ctp-teal: {{colors.tertiary.default.red}}, {{colors.tertiary.default.green}}, {{colors.tertiary.default.blue}};
  --ctp-green: {{colors.tertiary_fixed.default.red}}, {{colors.tertiary_fixed.default.green}}, {{colors.tertiary_fixed.default.blue}};
  --ctp-yellow: {{colors.tertiary_container.default.red}}, {{colors.tertiary_container.default.green}}, {{colors.tertiary_container.default.blue}};
  --ctp-peach: {{colors.secondary_container.default.red}}, {{colors.secondary_container.default.green}}, {{colors.secondary_container.default.blue}};
  --ctp-maroon: {{colors.error_container.default.red}}, {{colors.error_container.default.green}}, {{colors.error_container.default.blue}};
  --ctp-red: {{colors.error.default.red}}, {{colors.error.default.green}}, {{colors.error.default.blue}};
  --ctp-mauve: {{colors.primary_container.default.red}}, {{colors.primary_container.default.green}}, {{colors.primary_container.default.blue}};
  --ctp-pink: {{colors.on_tertiary_container.default.red}}, {{colors.on_tertiary_container.default.green}}, {{colors.on_tertiary_container.default.blue}};
  --ctp-flamingo: {{colors.on_primary_container.default.red}}, {{colors.on_primary_container.default.green}}, {{colors.on_primary_container.default.blue}};
  --ctp-rosewater: {{colors.on_secondary_container.default.red}}, {{colors.on_secondary_container.default.green}}, {{colors.on_secondary_container.default.blue}};

  /* Hex versions (Used by some specific UI elements) */
  --hex-blue: {{colors.primary.default.hex}};
  --hex-green: {{colors.tertiary.default.hex}};
  --hex-red: {{colors.error.default.hex}};
  --hex-peach: {{colors.secondary_container.default.hex}};
  --hex-yellow: {{colors.tertiary_container.default.hex}};
  --hex-mauve: {{colors.primary_container.default.hex}};
  --hex-pink: {{colors.on_tertiary_container.default.hex}};
  --hex-teal: {{colors.tertiary.default.hex}};
  --hex-sky: {{colors.secondary_fixed.default.hex}};
  --hex-sapphire: {{colors.secondary.default.hex}};
  --hex-lavender: {{colors.primary_fixed.default.hex}};
}
